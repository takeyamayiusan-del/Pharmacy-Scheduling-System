# ============================================================
# 雲端 Supabase 連線（用於匯出資料）
# 複製此檔為 scripts/.env.cloud 並填入實際值
# ============================================================
#
# 取得方式：Supabase Dashboard → Project Settings → API
#
CLOUD_SUPABASE_URL=https://您的專案.supabase.co
CLOUD_SUPABASE_SERVICE_ROLE_KEY=您的_service_role_key

# 備份會存放在專案 data/backups/（無需另外設定路徑）
